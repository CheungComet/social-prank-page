# ────────────────────────────────────────────────────────
# Notion CMS — required for dynamic content
# ────────────────────────────────────────────────────────

# 1. Go to https://www.notion.so/my-integrations
#    Click "+ New integration", give it a name (e.g. "My Portfolio")
#    Copy the "Internal Integration Token" here:
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. For each of the 4 databases below:
#    Open the database in Notion → click "Share" → "Invite" your integration
#    Then copy the database ID from the URL:
#    https://notion.so/<workspace>/<DATABASE_ID>?v=...
#                                  ^^^^^^^^^^^^

# 工作日志 database ID
# Required properties: Name (title), Date (date), Body (rich_text), Tags (multi_select)
NOTION_WORK_LOGS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 近期观察 database ID
# Required properties: Name (title), Date (date), Excerpt (rich_text),
#                      Tags (multi_select), ReadTime (rich_text), Type (select: analysis|research|commentary)
NOTION_OBSERVATIONS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 工作SOP database ID
# Required properties: Name (title), Description (rich_text), GitHub (url),
#                      Status (select: active|draft), Version (rich_text),
#                      Updated (date), Tags (multi_select)
NOTION_SOPS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 其他作品 database ID
# Required properties: Name (title), Description (rich_text), Type (select: article|video|tool),
#                      Date (date), Link (url), Featured (checkbox),
#                      Size (select: featured|tall|wide|third)
NOTION_WORKS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
